---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description={`About ${SITE_TITLE}.`}>
	<h1>About</h1>
	<p>
		I'm a software engineer at <a href="https://www.snowflake.com/">Snowflake</a>, living in
		Renton, Washington.
	</p>
	<!-- TODO: Fill in your background: education, past roles, what you work on. -->
	<p>
		Outside of work I like building personal projects across a lot of different stacks: Android apps
		in Kotlin, games in Unity and C#, iOS apps in Swift, and websites like this one.
	</p>

	<h2>Elsewhere</h2>
	<ul>
		{
			SOCIAL_LINKS.map((link) => (
				<li>
					<a href={link.href} rel="me">
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	h2 {
		margin-top: 1.5em;
	}
</style>
