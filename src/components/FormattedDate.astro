---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString('en-us', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		// Frontmatter dates are parsed as UTC midnight; format in UTC so the day never shifts.
		timeZone: 'UTC',
	})}
</time>
