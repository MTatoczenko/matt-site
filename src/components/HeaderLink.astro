---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// A link is active when its first path segment matches the current page's,
// so /blog/ stays highlighted on /blog/some-post/. Home ("/") has an empty segment.
function firstSegment(path: string): string {
	return path.split('/').filter((part) => part !== '')[0] ?? '';
}
const isActive = firstSegment(String(href)) === firstSegment(Astro.url.pathname);
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
